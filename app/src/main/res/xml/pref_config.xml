<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        app:key="cat_datos_personales"
        app:title="@string/datos_personales">
        <SwitchPreferenceCompat
            app:key="modo_oscuro"
            app:title="@string/modo_oscuro"
            app:defaultValue="false" />

        <ListPreference
            app:key="idioma"
            app:title="@string/idioma"
            app:summary="@string/selecciona_idioma"
            app:entries="@array/idiomas"
            app:entryValues="@array/idiomas_values"
            app:defaultValue="es"/>
    </PreferenceCategory>

</PreferenceScreen>