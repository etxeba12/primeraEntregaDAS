<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory
        app:key="cat_datos_personales"
        app:title="Datos Personales">
        <SwitchPreferenceCompat
            app:key="modo_oscuro"
            app:title="Modo oscuro"
            app:defaultValue="false" />
        <EditTextPreference
            app:key="nombre"
            app:title="Nombre"
            app:summary="Introduce tu nombre de usuario:"
            app:dialogTitle="Introduce un nombre:"
            app:dialogIcon="@mipmap/ic_launcher" />

        <ListPreference
            app:key="idioma"
            app:title="Idioma"
            app:summary="Selecciona el idioma de la aplicación"
            app:entries="@array/idiomas"
            app:entryValues="@array/idiomas_values"
            app:defaultValue="es"/>
    </PreferenceCategory>

</PreferenceScreen>